import { useState } from "react";
import { View, Text, TextInput, Switch, ScrollView, StyleSheet, Button } from 'react-native';
import Slider from '@react-native-community/slider';
 
export default function App() {
  // ESTADO EM TEMPO REAL: Mudam instantaneamente enquanto o usuário mexe na tela
  const [nome, setNome] = useState('');
  const [not, setNot] = useState(true);
  const [dif, setDif] = useState(5);
 
  // ESTADO DE VISIBILIDADE: Controla se o quadro de resultados deve ou não aparecer
  const [mostrarResultado, setMostrarResultado] = useState(false);
 
  // ESTADO DOS DADOS FINAIS: Armazena os valores "travados" que só mudam no momento do clique
  const [dadosFinais, setDadosFinais] = useState({
    nomeSalvo: '',
    notSalvo: true,
    difSalvo: 5
  });
 
  // FUNÇÃO DO CLIQUE: Captura o valor atual dos componentes e injeta nos dados finais
  const handleMostrarResultado = () => {
    setDadosFinais({
      nomeSalvo: nome,
      notSalvo: not,
      difSalvo: dif
    });
    setMostrarResultado(true); // Ativa a renderização do quadro na tela
  };
 
  return (
    <View style={estilos.contenedor}>
      {/* ScrollView com contentContainerStyle para garantir espaçamento e rolagem corretos */}
      <ScrollView contentContainerStyle={estilos.scrollContainer}>
       
        <Text style={estilos.titulo}>Configurações de perfil</Text>
       
        {/* Campo de Entrada de Texto (Input) com seu Nome no Placeholder */}
        <View style={estilos.bloco}>
          <Text style={estilos.rotulo}>Nome:</Text>
          <TextInput
            style={estilos.campo}
            placeholder="Ana Heloisa..."
            placeholderTextColor="#888888"
            onChangeText={(valor) => setNome(valor)}
            value={nome}
          />
        </View>
       
        {/* Componente de Switch (Alternador de Notificações) */}
        <View style={estilos.linha}>
          <Text style={estilos.rotulo}>Receber notificações:</Text>
          <Switch
            onValueChange={(valor) => setNot(valor)}
            value={not}
            trackColor={{ false: "#ff0000", true: "#329225" }}
            thumbColor={not ? "#000000ff" : '#ff0000'}
          />
        </View>
       
        {/* Componente de Slider (Nível de Dificuldade de 1 a 10) */}
        <View style={estilos.bloco}>
          <Text style={estilos.rotulo}>Nível de dificuldade: {dif}</Text>
          <Slider
            minimumValue={1}
            maximumValue={10}
            minimumTrackTintColor="#8d4ed6ff"
            maximumTrackTintColor="#25b3f5"
            onValueChange={(valor) => setDif(valor)}
            value={dif}
            step={1}
          />
        </View>
 
        {/* Botão para Processar e Exibir os Resultados */}
        <View style={estilos.btnContainer}>
          <Button
            title="Mostrar Resultados"
            onPress={handleMostrarResultado}
            color="#8d4ed6ff"
          />
        </View>
 
        {/* Quadro de Resultados: Renderização condicional amarrada ao estado 'dadosFinais' */}
        {mostrarResultado && (
          <View style={estilos.qdResultado}>
            <Text style={estilos.resultadoTitulo}>Dados Enviados:</Text>
            <Text style={estilos.resultadoTexto}>
              <Text style={estilos.negrito}>Nome:</Text> {dadosFinais.nomeSalvo || 'Nenhum nome inserido'}
            </Text>
            <Text style={estilos.resultadoTexto}>
              <Text style={estilos.negrito}>Notificação:</Text> {dadosFinais.notSalvo ? 'Ativado' : 'Desativado'}
            </Text>
            <Text style={estilos.resultadoTexto}>
              <Text style={estilos.negrito}>Dificuldade:</Text> {dadosFinais.difSalvo}
            </Text>
          </View>
        )}
 
      </ScrollView>
    </View>
  );
}
 
// Estilização Completa do App utilizando StyleSheet
const estilos = StyleSheet.create({
  contenedor: {
    flex: 1,
    backgroundColor: '#f5f5f5ff',
  },
  scrollContainer: {
    padding: 30,
    paddingTop: 60, // Evita que o topo do app suma atrás da barra de status do celular
    justifyContent: 'center',
  },
  titulo: {
    fontSize: 26,
    fontWeight: 'bold',
    marginBottom: 30,
    textAlign: 'center',
    color: '#020202ff'
  },
  bloco: {
    marginBottom: 20,
  },
  rotulo: {
    fontSize: 16,
    fontWeight: 'bold',
    marginBottom: 8,
    color: '#333',
  },
  campo: {
    height: 50,
    borderWidth: 1,
    borderColor: '#ddd',
    borderRadius: 8,
    paddingHorizontal: 15,
    backgroundColor: '#fff',
    fontSize: 16,
  },
  linha: {
    flexDirection: 'row',
    justifyContent: 'space-between', // Correção do bug de digitação anterior (justyfyContent)
    alignItems: 'center',
    marginBottom: 25,
    backgroundColor: '#fff',
    padding: 15,
    borderRadius: 8,
    borderWidth: 1,
    borderColor: '#eee'
  },
  btnContainer: {
    marginTop: 10,
    borderRadius: 8,
    overflow: 'hidden' // Corrige o visual do botão arredondado no Android
  },
  qdResultado: {
    marginTop: 30,
    padding: 20,
    backgroundColor: '#fff',
    borderRadius: 10,
    borderLeftWidth: 5,
    borderLeftColor: '#8d4ed6ff',
    elevation: 3, // Sombra para Android
    shadowColor: '#000', // Sombra para iOS
    shadowOffset: { width: 0, height: 2 },
    shadowOpacity: 0.1,
    shadowRadius: 4,
  },
  resultadoTitulo: {
    fontSize: 18,
    fontWeight: 'bold',
    color: '#8d4ed6ff',
    marginBottom: 10,
  },
  resultadoTexto: {
    fontSize: 16,
    color: '#444',
    marginBottom: 5,
  },
  negrito: {
    fontWeight: 'bold',
  }
});
